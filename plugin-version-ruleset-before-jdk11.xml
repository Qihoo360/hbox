<?xml version="1.0" encoding="UTF-8"?>
<ruleset xmlns="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" comparisonMethod="maven" xsi:schemaLocation="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0 https://www.mojohaus.org/versions-maven-plugin/xsd/rule-2.0.0.xsd">
  <rules>
    <rule artifactId="spotless-maven-plugin" comparisonMethod="maven" groupId="com.diffplug.spotless">
      <!-- from 2.31.0, spotless dropped support for jdk 8 -->
      <ignoreVersions>
        <ignoreVersion type="regex">^[1-9][0-9]+.*$</ignoreVersion>
        <ignoreVersion type="regex">^[3-9].*$</ignoreVersion>
        <ignoreVersion type="regex">^2\.[1-9][0-9][0-9]+.*$</ignoreVersion>
        <ignoreVersion type="regex">^2\.[4-9][0-9].*$</ignoreVersion>
        <ignoreVersion type="regex">^2\.3[1-9].*$</ignoreVersion>
      </ignoreVersions>
    </rule>
  </rules>
</ruleset>
